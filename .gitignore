# Project exclude paths
/target/
civstudio-engine/target/
civstudio-server/target/
/out/
/output/
/eos.iml
/.idea/.gitignore
/.idea/misc.xml
/.idea/modules.xml
/.idea/vcs.xml
/.idea/
/.claude/
/full.log
# webverify browser-test tooling deps (regenerable via `npm install`)
/tools/webverify/node_modules/
/tools/webverify/package-lock.json
# iso/3D spike: deps (regenerable via `npm install`) and its EXTRACTED data (regenerable via
# `node extract.mjs` — a province's baked terrain PNG + plot grid pulled out of the running app)
/tools/spike-iso3d/node_modules/
/tools/spike-iso3d/package-lock.json
/tools/spike-iso3d/data/
/tools/spike-iso3d/vendor/
# web build tooling deps (sharp — the WebP image encoder; regenerable via `npm install`)
/web/node_modules/
/web/package-lock.json
# NOTE: the baked web assets (web/assets/*.png, web/assets/plots.pack) are COMMITTED, non-LFS —
# ~20 MB total, regenerated by `node web/build.mjs` and checked in, so the Azure SWA deploy uploads
# the prebuilt web/ folder as-is instead of rebuilding (see .github/workflows/deploy-web.yml).
# Only the heavy build *inputs* stay out of git:
# Legacy: the sim used to persist per-province plot caches into the source tree here. They now go to
# the shared .map volume (see below) — the store never writes under src/ anymore. Kept as a
# guard against a stale checkout or old code regenerating into the tree.
/civstudio-engine/src/main/resources/map/provinces/
# Exporter/baker outputs (map/tech/unit/building/recipe JSON, non-human race name caches, …) are
# gitignored build-scratch, written under target/generated/ (already covered by the target/ rules
# above) — nothing downstream reads them: consumers read the world-bundle (prod: StrapiWorldSource
# over /api/world-bundle; tests/offline: the committed fixture at
# civstudio-engine/src/test/resources/world-bundle.json.gz). The one committed exporter output, the
# GeoNames place-name subset, is a normal resource at src/main/resources/geonames/subset.json.gz.
# See docs/exporter-outputs.md, docs/studio-datamodel-rebuild-plan.md and docs/names.md.
# derived .nif render sprites (the explored alternative to GameFont — docs/bonus-sprite-bake.md)
/tools/nif-bake/out/
# Anbennar EU4 mod files are no longer vendored. They are fetched on demand from GitLab (pinned by
# anbennar-source.lock) into a local cache by com.civstudio.data.AnbennarFiles — the *derived*
# map/*.json resources stay committed. See docs/anbennar-files.md. Ignore the cache + any leftover
# local checkout of the old vendored tree.
/.anbennar-cache/
/data/anbennar/

# Anbennar Fandom wiki scrape cache — fetched on demand by com.civstudio.wiki.export.WikiFiles
# (pinned by wiki-source.lock), dev-time only. See docs/wiki-lore-import-plan.md.
/.wiki-cache/

# Caveman2Cosmos (Civ4) art/XML — likewise no longer vendored. Fetched on demand from the C2C GitHub
# repo (pinned by civ4-source.lock) into a local cache by com.civstudio.data.Civ4Files (+ the
# web/civ4.mjs node sibling); dev-time only (nothing at runtime reads it). See docs/civ4-files.md.
/.civ4-cache/

# Civ VI SDK Assets — local symlink into the Steam-installed SDK (dev-time only, machine-specific).
/.civ6-cache

# GeoNames gazetteer dump (allCountries) — a single ~350MB archive dropped in by hand, read only at
# bake time to stamp real place names onto plots (com.civstudio.data.GeoNamesFiles). Never committed;
# the names it produces are baked into the plot cache, so nothing at runtime reads it.
/.geonames-cache/

# Server plot-grid cache — generated on demand, cached to a (persistent, in prod) volume. See
# docs/plot-serving.md.
/.map/

# webverify screenshot artifacts
/tools/webverify/*.png
# throwaway scratch files (underscore-prefixed): temp verify scripts, crops, server/deploy logs
/tools/webverify/_*
/web/_*

# Never commit a .env anywhere in the repo (real secrets: APP_KEYS, DB password, JWT, etc.).
.env
.env.*
# studio/ — the Strapi 5 CMS / admin backend (Node, NOT a Maven reactor module). Consolidated here
# from the project's own .gitignore so the root file is the single source of truth (the generic
# OS/editor boilerplate Strapi ships is intentionally NOT copied in — only the real build artifacts).
# See studio/CLAUDE.md.
/studio/node_modules/
/studio/dist/
/studio/build/
/studio/.strapi/
/studio/.tmp/
/studio/.strapi-updater.json
/studio/.strapi-cloud.json
/studio/exports/
/studio/license.txt
/studio/.tsbuildinfo
/studio/.eslintcache
/studio/coverage/
/studio/public/uploads/*
!/studio/public/uploads/.gitkeep

# spike shots: only the four the plan doc cites by name are kept; shot.mjs regenerates the rest
/tools/spike-iso3d/shot-topdown.png
/tools/spike-iso3d/shot-strong.png

# Art extracted from the installed game's FPK archives (tools/fpk/unpack.mjs). Never committed: it is the
# publisher's art, it is hundreds of megabytes, and it is reproducible from a local install in one command.
# Bakes that consume it must commit their OUTPUT (a sprite atlas), the way the tree and flag atlases already do,
# because CI has no game install to extract from.
/.civ4-fpk/
